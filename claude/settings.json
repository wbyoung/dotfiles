{
  "permissions": {
    "deny": [
      "Bash(curl:*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(wget:*)",
      "Read(~/.env*)",
      "Read(~/.ssh/*)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(rm *)",
      "Bash(yarn add *)"
    ],
    "ask-disabled": [
      "Bash",
      "Edit",
      "Write",
      "Agent"
    ]
  },
  "theme": "auto",
	"statusLine": {
		"type": "command",
		"command": "npx -y ccusage statusline",
		"padding": 0
	}
}
